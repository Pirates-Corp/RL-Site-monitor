# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.3bzohmz.mongodb.net/site-monitor?retryWrites=true&w=majority
# Secret used to sign JWTs - use a long random string
JWT_SECRET=replace_this_with_a_long_random_string

# Resend API key for daily email reports (free tier: resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
REPORT_FROM_EMAIL=roundlogics@gmail.com
REPORT_TO_EMAIL=you@example.com

# Shared secret so only your cron jobs (Vercel Cron / cron-job.org) can trigger checks
CRON_SECRET=replace_this_with_another_random_string
